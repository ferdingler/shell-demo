{
  "name": "strands-shell-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.12.0" },
  "bin": { "tryshell": "bridge/bridge.mjs" },
  "scripts": {
    "build:wasm": "bash engine/build.sh",
    "build": "npm run build:wasm && vite build web",
    "build:site": "vite build web",
    "dev": "vite web --host 127.0.0.1",
    "preview": "vite preview web --host 127.0.0.1",
    "test": "node --test web/test/*.test.js bridge/test/*.test.js",
    "check:browser": "node web/test/browser.mjs",
    "check:bridge": "node bridge/test/e2e.mjs"
  },
  "dependencies": {
    "@bytecodealliance/preview2-shim": "0.31.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.41.0",
    "playwright": "1.64.1",
    "vite": "8.3.5"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "esbuild": "0.28.2"
  }
}
